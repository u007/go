// Test enum type formatting.

package p

type Shape enum {
	Circle(float64)
	Rectangle(float64, float64)
	Point
}

type Option[T any] enum {
	Some(T)
	None
}

// Ensure "enum" remains a valid identifier.
var enum = 5
var _ = enum + 1
