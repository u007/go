This is the upstream change to golang.org/x/tools that the vendored copy in
src/vendor currently carries. It teaches the AST inspector about the new
ast.EnumType / ast.EnumVariant nodes introduced by the tagged-enums prototype.

Once this is merged into golang.org/x/tools (and the dependency is bumped), the
in-tree vendor patch below can be dropped and regenerated with `go mod vendor`.

Apply from the root of a golang.org/x/tools checkout with:

    git apply x-tools-enum-inspector.patch

--- a/go/ast/edge/edge.go
+++ b/go/ast/edge/edge.go
@@ -166,6 +166,11 @@ const (
 	ValueSpec_Type
 	ValueSpec_Values
 
+	// Enum support (Go 1.28 tagged enums).
+	EnumType_Variants
+	EnumVariant_Name
+	EnumVariant_Payload
+
 	maxKind
 )
 
@@ -215,6 +220,9 @@ var fieldInfos = [...]fieldInfo{
 	Ellipsis_Elt:          info[*ast.Ellipsis]("Elt"),
 	ExprStmt_X:            info[*ast.ExprStmt]("X"),
 	FieldList_List:        info[*ast.FieldList]("List"),
+	EnumType_Variants:     info[*ast.EnumType]("Variants"),
+	EnumVariant_Name:      info[*ast.EnumVariant]("Name"),
+	EnumVariant_Payload:   info[*ast.EnumVariant]("Payload"),
 	Field_Comment:         info[*ast.Field]("Comment"),
 	Field_Doc:             info[*ast.Field]("Doc"),
 	Field_Names:           info[*ast.Field]("Names"),
--- a/go/ast/inspector/walk.go
+++ b/go/ast/inspector/walk.go
@@ -134,6 +134,15 @@ func walk(v *visitor, ek edge.Kind, index int, node ast.Node) {
 	case *ast.StructType:
 		walk(v, edge.StructType_Fields, -1, n.Fields)
 
+	case *ast.EnumType:
+		walkList(v, edge.EnumType_Variants, n.Variants)
+
+	case *ast.EnumVariant:
+		walk(v, edge.EnumVariant_Name, -1, n.Name)
+		for i, x := range n.Payload {
+			walk(v, edge.EnumVariant_Payload, i, x)
+		}
+
 	case *ast.FuncType:
 		if n.TypeParams != nil {
 			walk(v, edge.FuncType_TypeParams, -1, n.TypeParams)
